{
  "name": "gonxiang-village-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:sites": "npm run build && node scripts/build-sites.mjs",
    "build:v85-sites": "node scripts/build-v85-sites.mjs",
    "build:shuzhi-pages-zip": "node scripts/build-shuzhi-pages-zip.mjs",

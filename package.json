    "build:v85-singlefile": "node scripts/build-v85-singlefile.mjs",
    "preview": "vite preview",
    "dev:local-api": "node local-backend/server.mjs",
    "dev:local-admin": "vite --config vite.admin.config.ts",
    "build:local-admin": "vite build --config vite.admin.config.ts",
    "dev:local": "node scripts/dev-local-stack.mjs",
    "build:shuzhi-mp": "npm --prefix work/shuzhi-v8502-source run build:mp-weixin:local",
    "build:shuzhi-mp-production": "npm --prefix work/shuzhi-v8502-source run build:mp-weixin:production",
    "build:shuzhi-h5-demo": "npm --prefix work/shuzhi-v8502-source run build:h5:demo && SHUZHI_H5_DEMO=true npm run sync:shuzhi-h5",

    "smoke:shuzhi-local": "node scripts/run-shuzhi-local-smoke.mjs",
    "backup:shuzhi": "node scripts/backup-shuzhi-local.mjs",
    "verify:shuzhi-backup": "node scripts/verify-shuzhi-backup.mjs"

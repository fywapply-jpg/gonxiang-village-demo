    "check:shuzhi-institution-client": "node scripts/check-shuzhi-institution-client.mjs",
    "check:shuzhi-institution-outbox": "node scripts/check-shuzhi-institution-outbox.mjs",
    "check:shuzhi-production-outbox": "node scripts/check-shuzhi-v8530-production-outbox.mjs",
    "check:shuzhi-concurrency": "node scripts/check-shuzhi-v8530-concurrency.mjs",
    "start:shuzhi-institution-worker": "node scripts/run-shuzhi-institution-worker.mjs",
    "check:secret-hygiene": "node scripts/check-secret-hygiene.mjs",
    "check:shuzhi-public": "node scripts/check-shuzhi-public-pages.mjs",
    "check:shuzhi-role-isolation": "node scripts/check-shuzhi-v8530-role-isolation.mjs",
    "check:shuzhi-startup": "node scripts/check-shuzhi-v8530-production-startup.mjs",
    "check:shuzhi-production-startup": "node scripts/check-shuzhi-v8530-production-startup.mjs",
    "check:shuzhi-production-settlement": "node scripts/check-shuzhi-v8530-production-settlement.mjs",
    "verify:production-deployment": "node scripts/verify-production-deployment.mjs",
    "check:shuzhi-access": "node scripts/run-shuzhi-check-with-local-api.mjs scripts/check-shuzhi-v8530-access.mjs",
    "check:shuzhi-webhooks": "node scripts/run-shuzhi-check-with-local-api.mjs scripts/check-shuzhi-v8530-webhooks.mjs",
    "check:shuzhi-settlement": "node scripts/run-shuzhi-check-with-local-api.mjs scripts/check-shuzhi-v8530-settlement.mjs",
    "check:shuzhi-batch-gate": "node scripts/check-shuzhi-v8530-batch-gate.mjs",
    "check:shuzhi-demand-flow": "node scripts/check-shuzhi-v8530-demand-flow.mjs",

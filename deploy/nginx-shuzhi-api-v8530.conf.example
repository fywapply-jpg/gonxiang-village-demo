# 数智供社 v8530 API 专用反向代理
# 前台 H5/后台由 EdgeOne Pages 托管；本文件只部署在 api.example.cn 所在服务器。
limit_req_zone $binary_remote_addr zone=shuzhi_api:10m rate=20r/s;

server {
    listen 443 ssl http2;
    server_name API_DOMAIN;
    ssl_certificate TLS_CERT_DIR/fullchain.pem;
    ssl_certificate_key TLS_CERT_DIR/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /health/live {
        proxy_pass http://127.0.0.1:8787/health/live;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location = /health/ready {
        proxy_pass http://127.0.0.1:8787/health/ready;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location = /health {
        proxy_pass http://127.0.0.1:8787/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location /api/ {
        limit_req zone=shuzhi_api burst=40 nodelay;
        proxy_pass http://127.0.0.1:8787/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-Id $request_id;
        client_max_body_size 1m;
    }
    location / {
        return 404;
    }
}

server {
    listen 80;
    server_name API_DOMAIN;
    return 301 https://$host$request_uri;
}

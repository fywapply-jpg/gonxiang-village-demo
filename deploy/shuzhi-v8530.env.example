# 数智供社 v8530 正式部署环境变量模板。复制到受限文件后替换所有 CHANGE_ME。
SHUZHI_RUNTIME_MODE=production
SHUZHI_DEPLOY_ENV=CHANGE_ME_ENV
SHUZHI_SERVICE_NAME=CHANGE_ME_SERVICE
# 前台交付包与后端兼容发布线分开标识，供健康探针和监控读取。
SHUZHI_PLATFORM_VERSION=v8533
SHUZHI_RELEASE_VERSION=v8530
PORT=8787
SHUZHI_DB=/var/lib/shuzhi-v8530/shuzhi.db
SHUZHI_MAX_BODY_BYTES=1048576
SHUZHI_WEBHOOK_REPLAY_WINDOW_SECONDS=300
SHUZHI_API_TOKEN=CHANGE_ME_LONG_RANDOM_INTERNAL_TOKEN
SHUZHI_ADMIN_TOKEN_ROLES={"CHANGE_ME_SUPER_TOKEN":"super","CHANGE_ME_OPS_TOKEN":"ops","CHANGE_ME_AUDIT_TOKEN":"audit","CHANGE_ME_FINANCE_TOKEN":"finance","CHANGE_ME_SERVICE_TOKEN":"service"}
# 微信身份认证 ready 后可改为 {}，未完成微信联调时才保留受控临时用户令牌。
SHUZHI_USER_TOKEN_PRINCIPALS={"CHANGE_ME_BUYER_SESSION":{"id":"buyer-user","name":"采购经办人","role":"buyer","merchant_id":"m-buyer"},"CHANGE_ME_SUPPLIER_SESSION":{"id":"supplier-user","name":"供货经办人","role":"supplier","merchant_id":"m-supplier"}}
# 微信小程序登录换取短时会话；openid 只用于服务端绑定，不下发给前端。
WECHAT_APP_ID=CHANGE_ME_WECHAT_APP_ID
WECHAT_APP_SECRET=CHANGE_ME_WECHAT_APP_SECRET
SHUZHI_WECHAT_SESSION_URL=https://api.weixin.qq.com/sns/jscode2session
SHUZHI_WECHAT_OPENID_PRINCIPALS={"CHANGE_ME_OPENID":{"id":"buyer-user","name":"采购经办人","role":"buyer","merchant_id":"m-buyer"}}
SHUZHI_ALLOWED_ORIGIN=https://CHANGE_ME_DOMAIN
# 这里只填 API 域名根地址；前端会自动拼接 /api/v1，不能再附加 /api。
VITE_API_BASE=https://CHANGE_ME_DOMAIN
# 每个机构独立生成至少 32 个字符的随机密钥；签名串为 HMAC-SHA256(timestamp.raw_body)。
LOGISTICS_WEBHOOK_SECRET=CHANGE_ME_LOGISTICS_SECRET
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_PAYMENT_SECRET
INVOICE_WEBHOOK_SECRET=CHANGE_ME_INVOICE_SECRET
REGULATOR_WEBHOOK_SECRET=CHANGE_ME_REGULATOR_SECRET
# 禁止配置 VITE_API_TOKEN、VITE_ADMIN_TOKEN，避免密钥进入浏览器/小程序静态包。
SHUZHI_WECHAT_AUTH_READY=false
SHUZHI_CA_READY=false
SHUZHI_PAYMENT_READY=false
SHUZHI_LOGISTICS_READY=false
SHUZHI_INVOICE_READY=false
SHUZHI_REGULATOR_READY=false
SHUZHI_BACKUP_DIR=/var/backups/shuzhi-v8530

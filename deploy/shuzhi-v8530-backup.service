[Unit]
Description=数智供社 v8530 SQLite backup
After=local-fs.target shuzhi-v8530.service
Requires=shuzhi-v8530.service
Before=shutdown.target

[Service]
Type=oneshot
User=shuzhi
Group=shuzhi
WorkingDirectory=/opt/shuzhi-v8530
EnvironmentFile=/etc/shuzhi-v8530.env
ExecStartPre=/usr/bin/node /opt/shuzhi-v8530/scripts/check-shuzhi-production-bootstrap.mjs
ExecStart=/usr/bin/node /opt/shuzhi-v8530/scripts/backup-shuzhi-local.mjs
UMask=027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
PrivateDevices=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/shuzhi-v8530 /var/backups/shuzhi-v8530
